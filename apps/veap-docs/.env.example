# Databuddy website id, safe to expose, used by the analytics script
NEXT_PUBLIC_DATABUDDY_CLIENT_ID=

# Databuddy API key with the read:data scope, server only, powers the pageview
DATABUDDY_API_KEY=

# Optional: absolute path to the documentation source (the folder that contains
# meta.json). Defaults to <repo>/docs/developer-docs, which is located
# automatically when the app runs from this monorepo.
VEAP_DOCS_ROOT=
