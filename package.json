{
  "name": "veap-repo",
  "private": true,
  "license": "MIT",
  "scripts": {
    "prepare": "husky",
    "build": "bun run build:packages",
    "build:packages": "bun --filter './packages/**' build",
    "build:plugins": "bun --filter './plugins/**' build",
    "dev": "bun --filter './packages/**' dev --filter './plugins/**' dev",
    "check": "biome check .",
    "check:write": "biome check --write .",
    "check:arch": "node scripts/check-arch.mjs",
    "check:docs": "node docs/scripts/check-docs.mjs",
    "check:types": "node scripts/check-types.mjs",
    "test": "bun --filter './packages/**' --filter './apps/**' test",
    "changeset": "changeset",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@commitlint/types": "^21.2.3",
    "@types/node": "^22.20.2",
    "husky": "^9.1.7",
    "rimraf": "^6.1.3",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "apps/*",
    "packages/*",
    "plugins/*",
    "templates/*"
  ]
}
