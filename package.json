{
  "name": "veap-repo",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "bun run build:packages && bun run build:plugins",
    "build:packages": "bun --filter './packages/**' build",
    "build:plugins": "bun --filter './plugins/**' build",
    "dev": "bun --filter './packages/**' dev --filter './plugins/**' dev",
    "check": "biome check .",
    "check:write": "biome check --write .",
    "check:arch": "node scripts/check-arch.mjs",
    "check-types": "tsc --noEmit",
    "test": "bun test --pass-with-no-tests",
    "changeset": "changeset",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@types/node": "^22.20.2",
    "rimraf": "^6.1.3",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "apps/*",
    "packages/*",
    "plugins/*",
    "templates/*"
  ]
}
